{
  "manifest_version": 3,
  "name": "Critter Tab",
  "version": "2.3.0",
  "description": "A living new tab: 24 pixel animals wander around and react to your clicks. Search box, themes, no tracking.",
  "permissions": [
    "search"
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "action": {
    "default_title": "Critter Tab",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}